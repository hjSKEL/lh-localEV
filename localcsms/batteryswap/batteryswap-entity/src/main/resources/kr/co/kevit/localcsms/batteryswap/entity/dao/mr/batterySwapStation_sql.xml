<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="kr.co.kevit.localcsms.batteryswap.entity.dao.BatterySwapStationMapper">

	<resultMap type="BatterySwapStation" id="BatterySwapStation-resultMap">
		<id     column="CP_ID"            property="cpId"/>
		<id     column="CS_ID"            property="csId"/>
		<result column="ENABLED"          property="enabled"/>
		<result column="OPER_STAT"        property="operationalStatus"/>
		<result column="TOT_SLT_CNT"      property="totalSlotCount"/>
		<result column="RSVD_SLT_CNT"     property="reservedSlotCount"/>
		<result column="BAT_MODEL"        property="supportedBatteryModel"/>
		<result column="DFT_ID_TOKEN"     property="defaultIdToken"/>
		<result column="DFT_ID_TOKEN_TP"  property="defaultIdTokenType"/>
		<result column="SWAP_TMO_SEC"     property="swapTimeoutSec"/>
		<result column="MIN_SOH"          property="minSoHThreshold"/>
		<result column="MIN_SOC"          property="minSoCForDispatch"/>
		<result column="REG_DT"           property="writer.registrationDate"/>
		<result column="REG_ID"           property="writer.regUserId"/>
		<result column="UPD_DT"           property="writer.updateDate"/>
		<result column="UPD_ID"           property="writer.updUserId"/>
	</resultMap>

	<resultMap type="BatterySwapStationDto" id="BatterySwapStationDto-resultMap" extends="BatterySwapStation-resultMap">
		<result column="CP_NM"            property="cpName"/>
	</resultMap>

	<insert id="insertBatterySwapStation" parameterType="BatterySwapStation">
	INSERT INTO TB_BSCS001(
		 CP_ID
		,CS_ID
		,ENABLED
		,OPER_STAT
		,TOT_SLT_CNT
		,RSVD_SLT_CNT
		,BAT_MODEL
		,DFT_ID_TOKEN
		,DFT_ID_TOKEN_TP
		,SWAP_TMO_SEC
		,MIN_SOH
		,MIN_SOC
		,REG_DT
		,REG_ID
		,UPD_DT
		,UPD_ID
	)VALUES(
		 #{station.cpId}
		,#{station.csId}
		,#{station.enabled}
		,#{station.operationalStatus}
		,#{station.totalSlotCount}
		,#{station.reservedSlotCount}
		,#{station.supportedBatteryModel}
		,#{station.defaultIdToken}
		,#{station.defaultIdTokenType}
		,#{station.swapTimeoutSec}
		,#{station.minSoHThreshold}
		,#{station.minSoCForDispatch}
		,#{station.writer.registrationDate}
		,#{station.writer.regUserId}
		,#{station.writer.updateDate}
		,#{station.writer.updUserId}
	)
	</insert>

	<update id="updateBatterySwapStation" parameterType="BatterySwapStation">
	UPDATE TB_BSCS001
	   SET ENABLED          = #{station.enabled}
	      ,OPER_STAT        = #{station.operationalStatus}
	      ,TOT_SLT_CNT      = #{station.totalSlotCount}
	      ,RSVD_SLT_CNT     = #{station.reservedSlotCount}
	      ,BAT_MODEL        = #{station.supportedBatteryModel}
	      ,DFT_ID_TOKEN     = #{station.defaultIdToken}
	      ,DFT_ID_TOKEN_TP  = #{station.defaultIdTokenType}
	      ,SWAP_TMO_SEC     = #{station.swapTimeoutSec}
	      ,MIN_SOH          = #{station.minSoHThreshold}
	      ,MIN_SOC          = #{station.minSoCForDispatch}
	      ,UPD_DT           = #{station.writer.updateDate}
	      ,UPD_ID           = #{station.writer.updUserId}
	 WHERE CP_ID = #{station.cpId}
	   AND CS_ID = #{station.csId}
	</update>

	<delete id="deleteBatterySwapStation">
	DELETE FROM TB_BSCS001
	 WHERE CP_ID = #{cpId}
	   AND CS_ID = #{csId}
	</delete>

	<delete id="deleteBatterySwapStationByCpId" parameterType="String">
	DELETE FROM TB_BSCS001
	 WHERE CP_ID = #{cpId}
	</delete>

	<select id="selectBatterySwapStation" resultMap="BatterySwapStation-resultMap">
	SELECT CP_ID
	      ,CS_ID
	      ,ENABLED
	      ,OPER_STAT
	      ,TOT_SLT_CNT
	      ,RSVD_SLT_CNT
	      ,BAT_MODEL
	      ,DFT_ID_TOKEN
	      ,DFT_ID_TOKEN_TP
	      ,SWAP_TMO_SEC
	      ,MIN_SOH
	      ,MIN_SOC
	      ,REG_DT
	      ,REG_ID
	      ,UPD_DT
	      ,UPD_ID
	  FROM TB_BSCS001
	 WHERE CP_ID = #{cpId}
	   AND CS_ID = #{csId}
	</select>

	<select id="selectBatterySwapStationByCpId" parameterType="String" resultMap="BatterySwapStation-resultMap">
	SELECT CP_ID
	      ,CS_ID
	      ,ENABLED
	      ,OPER_STAT
	      ,TOT_SLT_CNT
	      ,RSVD_SLT_CNT
	      ,BAT_MODEL
	      ,DFT_ID_TOKEN
	      ,DFT_ID_TOKEN_TP
	      ,SWAP_TMO_SEC
	      ,MIN_SOH
	      ,MIN_SOC
	      ,REG_DT
	      ,REG_ID
	      ,UPD_DT
	      ,UPD_ID
	  FROM TB_BSCS001
	 WHERE CP_ID = #{cpId}
	 ORDER BY CS_ID
	</select>

	<sql id="WhereForBatterySwapStationBySearchCond">
		<where>
			<if test="searchCond.cpId != null and searchCond.cpId != ''">
			AND A.CP_ID = #{searchCond.cpId}
			</if>
			<if test="searchCond.csId != null and searchCond.csId != ''">
			AND A.CS_ID = #{searchCond.csId}
			</if>
			<if test="searchCond.enabled != null and searchCond.enabled != ''">
			AND A.ENABLED = #{searchCond.enabled}
			</if>
			<if test="searchCond.operationalStatus != null and searchCond.operationalStatus != ''">
			AND A.OPER_STAT = #{searchCond.operationalStatus}
			</if>
			<if test="searchCond.cpName != null and searchCond.cpName != ''">
			AND B.CP_NM LIKE CONCAT('%',#{searchCond.cpName},'%')
			</if>
		</where>
	</sql>

	<select id="countBatterySwapStationBySearchCond" parameterType="BatterySwapStationSearchCond" resultType="Integer">
	SELECT COUNT(*)
	  FROM TB_BSCS001 A
	  LEFT OUTER JOIN TB_BSCP001 B
	    ON A.CP_ID = B.CP_ID
	<include refid="WhereForBatterySwapStationBySearchCond" />
	</select>

	<select id="selectBatterySwapStationBySearchCond" parameterType="BatterySwapStationSearchCond" resultMap="BatterySwapStationDto-resultMap">
	SELECT A.CP_ID
	      ,A.CS_ID
	      ,A.ENABLED
	      ,A.OPER_STAT
	      ,A.TOT_SLT_CNT
	      ,A.RSVD_SLT_CNT
	      ,A.BAT_MODEL
	      ,A.DFT_ID_TOKEN
	      ,A.DFT_ID_TOKEN_TP
	      ,A.SWAP_TMO_SEC
	      ,A.MIN_SOH
	      ,A.MIN_SOC
	      ,A.REG_DT
	      ,A.REG_ID
	      ,A.UPD_DT
	      ,A.UPD_ID
	      ,B.CP_NM
	  FROM TB_BSCS001 A
	  LEFT OUTER JOIN TB_BSCP001 B
	    ON A.CP_ID = B.CP_ID
	<include refid="WhereForBatterySwapStationBySearchCond" />
	 ORDER BY A.CP_ID, A.CS_ID
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>

</mapper>
