<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="kr.co.kevit.localcsms.charger.entity.dao.ChargePointMapper">

    <resultMap type="ChargePoint" id="ChargePoint-resultMap">
        <id 	column="CP_ID" property="cpId"/>
        <result column="CP_NM" property="cpName"/>
        <result column="HI_CS_CNT" property="highCsCount"/>
        <result column="LO_CS_CNT" property="lowCsCount"/>
        <result column="ELEC_SPLY_CPTY" property="electSupplyCapability"/>
        <result column="CP_LOC" property="cpLocation"/>
        <result column="CP_US_YN" property="cpUseYn"/>
        <result column="DEL_YN" property="deleteYn"/>
        <result column="DEL_DT" property="deleteDate"/>
        <result column="MEMO" property="memo"/>

        <result column="REG_DT" property="writer.registrationDate"/>
        <result column="REG_ID" property="writer.regUserId"/>
        <result column="UPD_DT" property="writer.updateDate"/>
        <result column="UPD_ID" property="writer.updUserId"/>
    </resultMap>

    <insert id="insertChargePoint" parameterType="ChargePoint">
    INSERT INTO TB_CHCP001(
    	 CP_ID
    	,CP_NM
    	,HI_CS_CNT
    	,LO_CS_CNT
    	,ELEC_SPLY_CPTY
    	,CP_LOC
    	,CP_US_YN
    	,DEL_YN
    	,DEL_DT
    	,MEMO
    	,REG_DT
    	,REG_ID
    	,UPD_DT
    	,UPD_ID
    )VALUES (
    	 #{chargePoint.cpId}
    	,#{chargePoint.cpName}
    	,#{chargePoint.highCsCount}
    	,#{chargePoint.lowCsCount}
    	,#{chargePoint.electSupplyCapability}
    	,#{chargePoint.cpLocation}
    	,#{chargePoint.cpUseYn}
    	,#{chargePoint.deleteYn}
    	,#{chargePoint.deleteDate}
    	,#{chargePoint.memo}
    	,#{chargePoint.writer.registrationDate}
    	,#{chargePoint.writer.regUserId}
    	,#{chargePoint.writer.updateDate}
    	,#{chargePoint.writer.updUserId}
    )
    </insert>

    <update id="updateChargePoint" parameterType="ChargePoint">
    UPDATE TB_CHCP001
       SET CP_NM        = #{chargePoint.cpName}
       	  ,HI_CS_CNT    = #{chargePoint.highCsCount}
          ,LO_CS_CNT    = #{chargePoint.lowCsCount}
          ,ELEC_SPLY_CPTY = #{chargePoint.electSupplyCapability}
          ,CP_LOC       = #{chargePoint.cpLocation}
          ,CP_US_YN     = #{chargePoint.cpUseYn}
          ,DEL_YN       = #{chargePoint.deleteYn}
          ,DEL_DT       = #{chargePoint.deleteDate}
          ,MEMO       	= #{chargePoint.memo}
          ,UPD_DT       = #{chargePoint.writer.updateDate}
          ,UPD_ID       = #{chargePoint.writer.updUserId}
        WHERE CP_ID = #{chargePoint.cpId}
    </update>

    <select id="selectChargePointByCpId" parameterType="String" resultMap="ChargePoint-resultMap">
    SELECT CP_ID
    	  ,CP_NM
    	  ,HI_CS_CNT
    	  ,LO_CS_CNT
    	  ,ELEC_SPLY_CPTY
    	  ,CP_LOC
    	  ,CP_US_YN
    	  ,DEL_YN
    	  ,DEL_DT
    	  ,MEMO
    	  ,REG_DT
    	  ,REG_ID
    	  ,UPD_DT
    	  ,UPD_ID
      FROM TB_CHCP001
     WHERE CP_ID = #{cpId}
    </select>

    <select id="selectChargePointByCpIds" parameterType="java.util.ArrayList" resultMap="ChargePoint-resultMap">
    SELECT CP_ID
    	  ,CP_NM
    	  ,HI_CS_CNT
    	  ,LO_CS_CNT
    	  ,ELEC_SPLY_CPTY
    	  ,CP_LOC
    	  ,CP_US_YN
    	  ,DEL_YN
    	  ,DEL_DT
    	  ,MEMO
    	  ,REG_DT
    	  ,REG_ID
    	  ,UPD_DT
    	  ,UPD_ID
      FROM TB_CHCP001
     WHERE CP_ID IN
     <foreach item="item" index="index" collection="cpIds" open="(" separator="," close=")">
            #{item}
     </foreach>
    </select>

    <select id="selectAllChargePoint" resultMap="ChargePoint-resultMap">
    SELECT CP_ID
    	  ,CP_NM
    	  ,HI_CS_CNT
    	  ,LO_CS_CNT
    	  ,ELEC_SPLY_CPTY
    	  ,CP_LOC
    	  ,CP_US_YN
    	  ,DEL_YN
    	  ,DEL_DT
    	  ,MEMO
    	  ,REG_DT
    	  ,REG_ID
    	  ,UPD_DT
    	  ,UPD_ID
      FROM TB_CHCP001
     ORDER BY CP_ID
    </select>

    <select id="countChargePointBySearchCond" parameterType="ChargePointSearchCond" resultType="Integer">
    SELECT COUNT(CP_ID)
      FROM TB_CHCP001
   	 <include refid="WhereForChargePointBySearchCond"/>
    </select>

    <sql id="WhereForChargePointBySearchCond">
     <where>
      <if test="searchCond.cpId != null and searchCond.cpId != '' ">
       AND CP_ID LIKE CONCAT(#{searchCond.cpId}, '%')
      </if>
      <if test="searchCond.cpName != null and searchCond.cpName != '' ">
       AND CP_NM LIKE CONCAT('%', #{searchCond.cpName}, '%')
      </if>
      <if test="searchCond.csType != null and searchCond.csType != '' and searchCond.csType == 'hiCs'">
       AND HI_CS_CNT > 0
      </if>
      <if test="searchCond.csType != null and searchCond.csType != '' and searchCond.csType == 'loCs'">
       AND LO_CS_CNT > 0
      </if>
     </where>
    </sql>

    <select id="selectChargePointBySearchCond" parameterType="ChargePointSearchCond" resultMap="ChargePoint-resultMap">
    SELECT CP_ID
    	  ,CP_NM
    	  ,HI_CS_CNT
    	  ,LO_CS_CNT
    	  ,ELEC_SPLY_CPTY
    	  ,CP_LOC
    	  ,CP_US_YN
    	  ,DEL_YN
    	  ,DEL_DT
    	  ,MEMO
    	  ,REG_DT
    	  ,REG_ID
    	  ,UPD_DT
    	  ,UPD_ID
      FROM TB_CHCP001
     <include refid="WhereForChargePointBySearchCond"/>
     ORDER BY CP_NM
     LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
    </select>

    <select id="selectMaxCpId" parameterType="String" resultType="String">
    SELECT MAX(CAST(RIGHT (CP_ID, 4) AS UNSIGNED)) + 1 AS CUR_SEQ
      FROM TB_CHCP001
     WHERE CP_ID LIKE CONCAT(#{siGunCode}, '%')
    </select>

</mapper>
