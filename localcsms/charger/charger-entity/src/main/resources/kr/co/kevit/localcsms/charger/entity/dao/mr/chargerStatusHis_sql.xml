<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper	namespace="kr.co.kevit.localcsms.charger.entity.dao.ChargerStatusHisMapper">
	<resultMap type="ChargerStatusInfoHis" id="ChargerStatusInfoHis-resultMap">
		<id     column="CS_STAT_ID" property="csStatusId" />
		<result column="CP_ID" property="cpId" />
		<result column="CS_ID" property="csId" />
		<result column="EVSE_ID" property="evseId" />
		<result column="INFO_COLL_DT" property="infoCollDate" />
		<result column="CS_CAT_CD" property="csCatCode" />
		<result column="CS_STAT_CD" property="csStatCode" />
		<result column="CS_CBL_STAT" property="csCableStatus" />
		<result column="RC_ID" property="rechargingId" />
		<result column="CS_ERR_STAT" property="csErrorStatus" />
		<result column="CU_ELE_NRG" property="cuEleEnerge" />
		<result column="CA_ELE_NRG" property="caEleEnerge" />
		<result column="INST_CH_AMT" property="instChAmont" />
		<result column="INST_CH_CST" property="instChCost" />
		<result column="INST_CH_SUM" property="instChSum" />
		<result column="CH_SUM" property="chSum" />
		<result column="CH_ST_DT" property="chStartDate" />
		<result column="CH_ED_DT" property="chEndDate" />
		<result column="LST_CH_ST_DT" property="lastChStartDate" />
		<result column="LST_CH_ED_DT" property="lastChEndDate" />
		<result column="CUT_CRD_NO" property="cutCardNo" />
		<result column="EVENT_CD" property="eventCode" />
		<result column="CS_CBL_SPD" property="csCableSpeed" />
		<result column="UPD_DT" property="updateDate" />
	</resultMap>
	
	<insert id="insertChargerStatusHis" parameterType="ChargerStatusInfo">
	INSERT INTO TB_CHCS006(
		 CP_ID
		,CS_ID
		,EVSE_ID
		,INFO_COLL_DT
		,CS_CAT_CD
		,CS_STAT_CD
		,CS_CBL_STAT
		,RC_ID
		,CS_ERR_STAT
		,CU_ELE_NRG
		,CA_ELE_NRG
		,INST_CH_AMT
		,INST_CH_CST
		,INST_CH_SUM
		,CH_SUM
		,CH_ST_DT
		,CH_ED_DT
		,LST_CH_ST_DT
		,LST_CH_ED_DT
		,CUT_CRD_NO
		,EVENT_CD
		,CS_CBL_SPD
		,UPD_DT
	)VALUES(
		 #{chargerStatusInfo.cpId}
		,#{chargerStatusInfo.csId}
		,#{chargerStatusInfo.evseId}
		,#{chargerStatusInfo.infoCollDate}
		,#{chargerStatusInfo.csCatCode}
		,#{chargerStatusInfo.csStatCode}
		,#{chargerStatusInfo.csCableStatus}
		,#{chargerStatusInfo.rechargingId}
		,#{chargerStatusInfo.csErrorStatus}
		,#{chargerStatusInfo.cuEleEnerge}
		,#{chargerStatusInfo.caEleEnerge}
		,#{chargerStatusInfo.instChAmont}
		,#{chargerStatusInfo.instChCost}
		,#{chargerStatusInfo.instChSum}
		,#{chargerStatusInfo.chSum}
		,#{chargerStatusInfo.chStartDate}
		,#{chargerStatusInfo.chEndDate}
		,#{chargerStatusInfo.lastChStartDate}
		,#{chargerStatusInfo.lastChEndDate}
		,#{chargerStatusInfo.cutCardNo}
		,#{chargerStatusInfo.eventCode}
		,#{chargerStatusInfo.csCableSpeed}
		,#{chargerStatusInfo.updateDate}
	)
	</insert>
	
	<select id="countChargerStatusInfoHisBySearchCond" parameterType="ChargerStatusInfoHisSearchCond" resultType="Integer">
	SELECT COUNT(A.CS_STAT_ID)
	  FROM TB_CHCS006 A
	  <include refid="WhereForChargerStatusInfoHisBySearchCond"/>
	</select>
	
	<sql id="WhereForChargerStatusInfoHisBySearchCond">
	 <where>
		<if test="searchCond.cpId != null and searchCond.cpId != '' and searchCond.csId != null and searchCond.csId != '' ">
	   AND CP_ID = #{searchCond.cpId}
	   AND CS_ID = #{searchCond.csId}
		</if>
		<if test="searchCond.evseId > 0">
	   AND EVSE_ID = #{searchCond.evseId}
		</if>
		<if test="searchCond.csStatusId > 0">
	   AND CS_STAT_ID &lt; #{searchCond.csStatusId}
		</if>
		<if test="searchCond.toDate != null and searchCond.toDate != ''">
	   AND INFO_COLL_DT &lt; DATE_FORMAT(#{searchCond.toDate}, '%Y%m%d%H%i%S')
		</if>
	</where>
	</sql>
	
	<select id="selectChargerStatusInfoHisBySearchCond" parameterType="ChargerStatusInfoHisSearchCond" resultMap="ChargerStatusInfoHis-resultMap">
	SELECT CS_STAT_ID
		  ,CP_ID
		  ,CS_ID
		  ,EVSE_ID
		  ,INFO_COLL_DT
		  ,CS_CAT_CD
		  ,CS_STAT_CD
		  ,CS_CBL_STAT
		  ,RC_ID
		  ,CS_ERR_STAT
		  ,CU_ELE_NRG
		  ,CA_ELE_NRG
		  ,INST_CH_AMT
		  ,INST_CH_CST
		  ,INST_CH_SUM
		  ,CH_SUM
		  ,CH_ST_DT
		  ,CH_ED_DT
		  ,LST_CH_ST_DT
		  ,LST_CH_ED_DT
		  ,CUT_CRD_NO
		  ,EVENT_CD
		  ,CS_CBL_SPD
		  ,UPD_DT
	  FROM TB_CHCS006
	  <include refid="WhereForChargerStatusInfoHisBySearchCond"/>
	 ORDER BY CS_STAT_ID DESC
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>

	<!-- 인증이력(/recharging/authorize/list) : EVENT_CD가 EVT0A1(인증성공)/EVT0A2(인증실패)인 이력만 조회 -->
	<resultMap type="ChargerAuthHis" id="ChargerAuthHis-resultMap">
		<id     column="CS_STAT_ID" property="csStatusId" />
		<result column="CP_ID" property="cpId" />
		<result column="CS_ID" property="csId" />
		<result column="INFO_COLL_DT" property="infoCollDate" />
		<result column="CUT_CRD_NO" property="cutCardNo" />
		<result column="EVENT_CD" property="eventCode" />
		<result column="CP_NM" property="cpName" />
		<result column="CUT_ID" property="customerId" />
		<result column="CUT_NM" property="custName" />
	</resultMap>

	<sql id="WhereForChargerAuthHisBySearchCond">
	 <where>
		AND A.EVENT_CD IN ('EVT0A1', 'EVT0A2')
		<if test="searchCond.cpId != null and searchCond.cpId != '' and searchCond.csId != null and searchCond.csId != '' ">
	   AND A.CP_ID = #{searchCond.cpId}
	   AND A.CS_ID = #{searchCond.csId}
		</if>
		<if test="searchCond.cpName != null and searchCond.cpName != ''">
	   AND C.CP_NM LIKE CONCAT('%', #{searchCond.cpName}, '%')
		</if>
		<if test="searchCond.custName != null and searchCond.custName != ''">
	   AND CU.CUT_NM LIKE CONCAT('%', #{searchCond.custName}, '%')
		</if>
		<if test="searchCond.cutCardNo != null and searchCond.cutCardNo != ''">
	   AND A.CUT_CRD_NO LIKE CONCAT('%', #{searchCond.cutCardNo}, '%')
		</if>
		<if test="searchCond.fromDate != null and searchCond.fromDate != ''">
	   AND A.INFO_COLL_DT &gt;= DATE_FORMAT(#{searchCond.fromDate}, '%Y%m%d%H%i%S')
		</if>
		<if test="searchCond.toDate != null and searchCond.toDate != ''">
	   AND A.INFO_COLL_DT &lt;= DATE_FORMAT(#{searchCond.toDate}, '%Y%m%d%H%i%S')
		</if>
	</where>
	</sql>

	<select id="countChargerAuthHisBySearchCond" parameterType="ChargerAuthHisSearchCond" resultType="Integer">
	SELECT COUNT(A.CS_STAT_ID)
	  FROM TB_CHCS006 A
		   LEFT JOIN TB_CHCP001 C
		ON A.CP_ID = C.CP_ID
		   LEFT JOIN TB_CUCA001 CA
		ON A.CUT_CRD_NO = CA.CUT_CRD_NO
		   LEFT JOIN TB_CUCU001 CU
		ON CA.CUT_ID = CU.CUT_ID
	  <include refid="WhereForChargerAuthHisBySearchCond"/>
	</select>

	<select id="selectChargerAuthHisBySearchCond" parameterType="ChargerAuthHisSearchCond" resultMap="ChargerAuthHis-resultMap">
	SELECT A.CS_STAT_ID
		  ,A.CP_ID
		  ,A.CS_ID
		  ,A.INFO_COLL_DT
		  ,A.CUT_CRD_NO
		  ,A.EVENT_CD
		  ,C.CP_NM
		  ,CA.CUT_ID
		  ,CU.CUT_NM
	  FROM TB_CHCS006 A
		   LEFT JOIN TB_CHCP001 C
		ON A.CP_ID = C.CP_ID
		   LEFT JOIN TB_CUCA001 CA
		ON A.CUT_CRD_NO = CA.CUT_CRD_NO
		   LEFT JOIN TB_CUCU001 CU
		ON CA.CUT_ID = CU.CUT_ID
	  <include refid="WhereForChargerAuthHisBySearchCond"/>
	 ORDER BY A.CS_STAT_ID DESC
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>

</mapper>
