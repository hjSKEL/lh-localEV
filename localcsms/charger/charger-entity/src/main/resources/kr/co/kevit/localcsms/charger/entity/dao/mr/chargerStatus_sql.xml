	<insert id="insertChargerStatus" parameterType="ChargerStatusInfo">
	INSERT INTO TB_CHCS005(
		 CP_ID
		,CS_ID
		,EVSE_ID
		,INFO_COLL_DT
		,CS_CAT_CD
		,CS_STAT_CD
		,CS_CBL_STAT
		,RC_ID
		,CS_ERR_STAT
		,CU_ELE_NRG
		,CA_ELE_NRG
		,INST_CH_AMT
		,INST_CH_CST
		,INST_CH_SUM
		,CH_SUM
		,CU_DA_ELE_NRG
		,DA_ELE_NRG
		,INST_DCH_AMT
		,INST_DCH_CST
		,INST_DCH_SUM
		,DCH_SUM
		,CH_ST_DT
		,CH_ED_DT
		,LST_CH_ST_DT
		,LST_CH_ED_DT
		,CUT_CRD_NO
		,EVENT_CD
		,CS_CBL_SPD
		,UPD_DT
	)VALUES(
		 #{chargerStatus.cpId}
		,#{chargerStatus.csId}
		,#{chargerStatus.evseId}
		,#{chargerStatus.infoCollDate}
		,#{chargerStatus.csCatCode}
		,#{chargerStatus.csStatCode}
		,#{chargerStatus.csCableStatus}
		,#{chargerStatus.rechargingId}
		,#{chargerStatus.csErrorStatus}
		,#{chargerStatus.cuEleEnerge}
		,#{chargerStatus.caEleEnerge}
		,#{chargerStatus.instChAmont}
		,#{chargerStatus.instChCost}
		,#{chargerStatus.instChSum}
		,#{chargerStatus.chSum}
		,#{chargerStatus.cuDaEleEnerge}
		,#{chargerStatus.daEleEnerge}
		,#{chargerStatus.instDchAmont}
		,#{chargerStatus.instDchCost}
		,#{chargerStatus.instDchSum}
		,#{chargerStatus.dchSum}
		,#{chargerStatus.chStartDate}
		,#{chargerStatus.chEndDate}
		,#{chargerStatus.lastChStartDate}
		,#{chargerStatus.lastChEndDate}
		,#{chargerStatus.cutCardNo}
		,#{chargerStatus.eventCode}
		,#{chargerStatus.csCableSpeed}
		,#{chargerStatus.updateDate}
	)
	</insert>

	<update id="updateChargerStatus" parameterType="ChargerStatusInfo">
	UPDATE TB_CHCS005
	   SET INFO_COLL_DT 	= #{chargerStatus.infoCollDate}
	      ,CS_CAT_CD  		= #{chargerStatus.csCatCode}
	      ,CS_STAT_CD 		= #{chargerStatus.csStatCode}
	      ,CS_CBL_STAT 	= 	#{chargerStatus.csCableStatus}
	      ,RC_ID 			= #{chargerStatus.rechargingId}
	      ,CS_ERR_STAT 	= #{chargerStatus.csErrorStatus}
	      ,CU_ELE_NRG 		= #{chargerStatus.cuEleEnerge}
	      ,CA_ELE_NRG 		= #{chargerStatus.caEleEnerge}
	      ,INST_CH_AMT 		= #{chargerStatus.instChAmont}
	      ,INST_CH_CST 		= #{chargerStatus.instChCost}
	      ,INST_CH_SUM 		= #{chargerStatus.instChSum}
	      ,CH_SUM 			= #{chargerStatus.chSum}
	      ,CU_DA_ELE_NRG	= #{chargerStatus.cuDaEleEnerge}
	      ,DA_ELE_NRG		= #{chargerStatus.daEleEnerge}
	      ,INST_DCH_AMT		= #{chargerStatus.instDchAmont}
	      ,INST_DCH_CST		= #{chargerStatus.instDchCost}
	      ,INST_DCH_SUM		= #{chargerStatus.instDchSum}
	      ,DCH_SUM			= #{chargerStatus.dchSum}
	      ,CH_ST_DT 		= #{chargerStatus.chStartDate}
	      ,CH_ED_DT 		= #{chargerStatus.chEndDate}
	      ,LST_CH_ST_DT 	= #{chargerStatus.lastChStartDate}
	      ,LST_CH_ED_DT 	= #{chargerStatus.lastChEndDate}
	      ,CUT_CRD_NO 		= #{chargerStatus.cutCardNo}
	      ,EVENT_CD 		= #{chargerStatus.eventCode}
	      ,CS_CBL_SPD 		= #{chargerStatus.csCableSpeed}
	      ,UPD_DT 			= #{chargerStatus.updateDate}
	 WHERE CP_ID	= #{chargerStatus.cpId}
	   AND CS_ID	= #{chargerStatus.csId}
	   AND EVSE_ID	= #{chargerStatus.evseId}
	</update>

	<select id="selectChargerStatusByCpIdNCsId" parameterType="java.util.HashMap" resultMap="ChargerStatusInfo-resultMap">
	SELECT CP_ID
		  ,CS_ID
		  ,EVSE_ID
		  ,INFO_COLL_DT
		  ,CS_CAT_CD
		  ,CS_STAT_CD
		  ,CS_CBL_STAT
		  ,RC_ID
		  ,CS_ERR_STAT
		  ,CU_ELE_NRG
		  ,CA_ELE_NRG
		  ,INST_CH_AMT
		  ,INST_CH_CST
		  ,INST_CH_SUM
		  ,CH_SUM
		  ,CU_DA_ELE_NRG
		  ,DA_ELE_NRG
		  ,INST_DCH_AMT
		  ,INST_DCH_CST
		  ,INST_DCH_SUM
		  ,DCH_SUM
		  ,CH_ST_DT
		  ,CH_ED_DT
		  ,LST_CH_ST_DT
		  ,LST_CH_ED_DT
		  ,CUT_CRD_NO
		  ,EVENT_CD
		  ,CS_CBL_SPD
		  ,UPD_DT
	  FROM TB_CHCS005
	 WHERE CP_ID = #{cpId}
		<if test="csId != null and csId != '' ">
	   AND CS_ID = #{csId}
		</if>
	</select>
	
	<select id="countChargerStatusBySearchCond" parameterType="ChargerStatusSearchCond" resultType="Integer">
	SELECT COUNT(A.CP_ID)
	  FROM TB_CHCP001 C
	  	   INNER JOIN TB_CHCS001 A
	  	ON C.CP_ID = A.CP_ID
	       INNER JOIN TB_CHCS005 B
	    ON B.CP_ID = A.CP_ID
	   AND B.CS_ID = A.CS_ID
	 <include refid="WhereForChargerStatusBySearchCond" />
	</select>

	<sql id="WhereForChargerStatusBySearchCond">
	 <where>
		<if test="searchCond.cpId != null and searchCond.cpId != '' ">
	   AND C.CP_ID LIKE CONCAT(#{searchCond.cpId}, '%')
		</if>
		<if test="searchCond.csId != null and searchCond.csId != '' ">
	   AND A.CS_ID = #{searchCond.csId}
		</if>
		<if test="searchCond.makerType != null and searchCond.makerType != '' ">
	   AND A.MAKER_TP = #{searchCond.makerType}
		</if>
		<if test="searchCond.cpName != null and searchCond.cpName != '' ">
	   AND C.CP_NM LIKE CONCAT('%', #{searchCond.cpName}, '%')
		</if>
		<if test="searchCond.status != null and searchCond.status.size != 0 ">
	   AND B.CS_STAT_CD IN
	    	<foreach item="item" index="index" collection="searchCond.status" open="(" separator="," close=")">
	        	#{item}
	    	</foreach>
		</if>
		<if test="searchCond.csErrorStatus != null and searchCond.csErrorStatus != '' ">
	   AND B.CS_ERR_STAT = #{searchCond.csErrorStatus}
		</if>
	</where>
	</sql>

	<select id="selectChargerStatusBySearchCond" parameterType="ChargerStatusSearchCond" resultMap="ChargerStatusInfoDto-resultMap">
	SELECT B.CP_ID
		  ,B.CS_ID
		  ,B.EVSE_ID
		  ,B.INFO_COLL_DT
		  ,B.CS_CAT_CD
		  ,B.CS_STAT_CD
		  ,B.CS_CBL_STAT
		  ,B.RC_ID
		  ,B.CS_ERR_STAT
		  ,B.CU_ELE_NRG
		  ,B.CA_ELE_NRG
		  ,B.INST_CH_AMT
		  ,B.INST_CH_CST
		  ,B.INST_CH_SUM
		  ,B.CH_SUM
		  ,B.CU_DA_ELE_NRG
		  ,B.DA_ELE_NRG
		  ,B.INST_DCH_AMT
		  ,B.INST_DCH_CST
		  ,B.INST_DCH_SUM
		  ,B.DCH_SUM
		  ,B.CH_ST_DT
		  ,B.CH_ED_DT
		  ,B.LST_CH_ST_DT
		  ,B.LST_CH_ED_DT
		  ,B.CUT_CRD_NO
		  ,B.EVENT_CD
		  ,B.CS_CBL_SPD
		  ,B.UPD_DT
		  ,C.CP_NM
		  ,CX.CX_NM
		  ,CASE WHEN B.CS_STAT_CD = 'CHRS04' THEN F.CUT_NM ELSE E.CUT_NM END AS CUT_NM
		  ,CASE WHEN B.CS_STAT_CD = 'CHRS04' THEN F.DONG ELSE E.DONG END AS DONG
		  ,CASE WHEN B.CS_STAT_CD = 'CHRS04' THEN F.HO ELSE E.HO END AS HO
	  FROM TB_CHCP001 C
	       INNER JOIN TB_CHCS001 A
	  	ON C.CP_ID = A.CP_ID
	       INNER JOIN TB_CHCS005 B
	    ON B.CP_ID = A.CP_ID
	   AND B.CS_ID = A.CS_ID
	       LEFT JOIN TB_ORCX001 CX
	    ON C.CX_ID = CX.CX_ID
	       LEFT JOIN TB_CUCU002 D
	    ON B.CUT_CRD_NO = D.CUT_CRD_NO
	       LEFT JOIN TB_CUCU001 E
	    ON D.CUT_ID = E.CUT_ID
	       LEFT JOIN TB_RCRC001 R
	    ON B.RC_ID = R.RC_ID
	       LEFT JOIN TB_CUCU001 F
	    ON R.CUT_ID = F.CUT_ID
	 <include refid="WhereForChargerStatusBySearchCond" />
	 ORDER BY C.CP_NM
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>

	<delete id="deleteChargerStatusByCpIdNCsId" parameterType="java.util.HashMap">
		DELETE FROM TB_CHCS005
		WHERE CP_ID = #{cpId}
		  AND CS_ID = #{csId}
	</delete>
</mapper>
