		<id		column="CS_ID" property="csId" />
		<result column="EVSE_ID" property="evseId" />
		<result column="INFO_COLL_DT" property="infoCollDate" />
		<result column="CS_CAT_CD" property="csCatCode" />
		<result column="CS_STAT_CD" property="csStatCode" />
		<result column="CS_CBL_STAT" property="csCableStatus" />
		<result column="RC_ID" property="rechargingId" />
		<result column="CS_ERR_STAT" property="csErrorStatus" />
		<result column="CU_ELE_NRG" property="cuEleEnerge" />
		<result column="CA_ELE_NRG" property="caEleEnerge" />
		<result column="INST_CH_AMT" property="instChAmont" />
		<result column="INST_CH_CST" property="instChCost" />
		<result column="INST_CH_SUM" property="instChSum" />
		<result column="CH_SUM" property="chSum" />
		<result column="CU_DA_ELE_NRG" property="cuDaEleEnerge" />
		<result column="DA_ELE_NRG" property="daEleEnerge" />
		<result column="INST_DCH_AMT" property="instDchAmont" />
		<result column="INST_DCH_CST" property="instDchCost" />
		<result column="INST_DCH_SUM" property="instDchSum" />
