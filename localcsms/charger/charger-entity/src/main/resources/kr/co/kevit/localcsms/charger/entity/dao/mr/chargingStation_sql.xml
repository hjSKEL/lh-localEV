		  ,D.OPER_STAT
		  ,D.TOT_SLT_CNT
		  ,D.RSVD_SLT_CNT
		  ,D.BAT_MODEL
		  ,D.DFT_ID_TOKEN
		  ,D.DFT_ID_TOKEN_TP
