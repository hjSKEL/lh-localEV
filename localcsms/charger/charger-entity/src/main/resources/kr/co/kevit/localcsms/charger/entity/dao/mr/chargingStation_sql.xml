	<select id="countChargingStationBySearchCond" parameterType="ChargingStationSearchCond" resultType="Integer">
	SELECT COUNT(A.CP_ID)
	  FROM TB_CHCP001 C
	  	   INNER JOIN TB_CHCS001 A
	  	ON C.CP_ID = A.CP_ID
	 <include refid="WhereForChargingStationBySearchCond" />
	</select>
	
	<sql id="WhereForChargingStationBySearchCond">
	 <where>
		<if test="searchCond.cpId != null and searchCond.cpId != '' ">
	   AND C.CP_ID LIKE CONCAT(#{searchCond.cpId}, '%')
		</if>
		<if test="searchCond.cpName != null and searchCond.cpName != '' ">
	   AND C.CP_NM LIKE CONCAT('%', #{searchCond.cpName}, '%')
		</if>
		<if test="searchCond.csUniqId != null and searchCond.csUniqId != '' ">
	   AND A.CS_UNIQ_ID LIKE CONCAT(#{searchCond.csUniqId}, '%')
		</if>
		 <if test="searchCond.makerType != null and searchCond.makerType != '' ">
		AND A.MAKER_TP  = #{searchCond.makerType}
		 </if>
		 <if test="searchCond.csKindType != null and searchCond.csKindType != '' ">
		AND A.CS_KN_TP  = #{searchCond.csKindType}
		 </if>
		 <if test="searchCond.ocppVersion != null and searchCond.ocppVersion != '' ">
		AND A.OCPP_VER  = #{searchCond.ocppVersion}
		 </if>
		 <if test="searchCond.csServiceType != null and searchCond.csServiceType != '' ">
		AND A.CS_SVC_TP = #{searchCond.csServiceType}
		 </if>
	</where>
	</sql>
	
	<select id="selectChargingStationBySearchCond" parameterType="ChargingStationSearchCond" resultMap="ChargingStationDto-resultMap">
	SELECT A.CP_ID
		  ,A.CS_ID
		  ,A.CS_UNIQ_ID
		  ,A.CS_CHN_CNT
		  ,A.ELEC_SPLY_CPTY
		  ,A.CS_CAT_CD
		  ,A.US_YN
		  ,A.BD_YN
		  ,A.MAKER_TP
		  ,A.INS_YR_MO
		  ,A.CS_INS_CO
		  ,A.PRD_TP
		  ,A.CS_PWD
		  ,A.LST_CS_PWD
		  ,A.CS_KN_TP
		  ,A.OCPP_VER
		  ,A.V2X_TP
		  ,A.CS_SVC_TP
		  ,A.LH_CP_CS_ID
		  ,A.CPO_CP_CS_ID
		  ,A.REG_DT
		  ,A.REG_ID
		  ,A.UPD_DT
		  ,A.UPD_ID
		  ,B.FW_VER
		  ,B.MODEL_NM
		  ,B.SER_NO
		  ,B.LAST_BOOT_DT
		  ,C.CP_NM
		  ,CX.CX_NM
	  FROM TB_CHCP001 C
	  	   INNER JOIN TB_CHCS001 A
		ON C.CP_ID = A.CP_ID
		   LEFT JOIN TB_CHCS002 B
		ON A.CP_ID = B.CP_ID
	   AND A.CS_ID = B.CS_ID
		   LEFT JOIN TB_ORCX001 CX
		ON C.CX_ID = CX.CX_ID
	 <include refid="WhereForChargingStationBySearchCond" />
	 <choose>
		<when test="searchCond.sortOrder == 'A'.toString()">ORDER BY C.CP_NM ASC</when>
		<when test="searchCond.sortOrder == 'B'.toString()">ORDER BY C.CP_NM DESC</when>
		<when test="searchCond.sortOrder == 'C'.toString()">ORDER BY A.CS_ID ASC</when>
		<when test="searchCond.sortOrder == 'D'.toString()">ORDER BY A.CS_ID DESC</when>
		<when test="searchCond.sortOrder == 'E'.toString()">ORDER BY A.ELEC_SPLY_CPTY ASC</when>
		<when test="searchCond.sortOrder == 'F'.toString()">ORDER BY A.ELEC_SPLY_CPTY DESC</when>
		<when test="searchCond.sortOrder == 'G'.toString()">ORDER BY A.INS_YR_MO ASC</when>
		<when test="searchCond.sortOrder == 'H'.toString()">ORDER BY A.INS_YR_MO DESC</when>
		<when test="searchCond.sortOrder == 'I'.toString()">ORDER BY A.REG_DT ASC</when>
		<when test="searchCond.sortOrder == 'J'.toString()">ORDER BY A.REG_DT DESC</when>
		<otherwise>ORDER BY C.CP_NM</otherwise>
	 </choose>
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>
	
	<delete id="deleteChargingStation" parameterType="java.util.HashMap">
	DELETE FROM TB_CHCS001
	  WHERE CP_ID = #{cpId}
		AND CS_ID = #{csId}
	</delete>
	
	<delete id="deleteChargingStationCsm" parameterType="java.util.HashMap">
	DELETE FROM TB_CHCS002
	 WHERE CP_ID = #{cpId}
	   AND CS_ID = #{csId}
	</delete>

</mapper>
