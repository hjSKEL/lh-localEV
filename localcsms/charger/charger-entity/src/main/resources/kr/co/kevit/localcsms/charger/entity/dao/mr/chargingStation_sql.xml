	<insert id="insertChargingStation" parameterType="ChargingStation">
	INSERT INTO TB_CHCS001(
		 CP_ID
		,CS_ID
		,CS_UNIQ_ID
		,CS_CHN_CNT
		,ELEC_SPLY_CPTY
		,CS_CAT_CD
		,US_YN
		,BD_YN
		,MAKER_TP
		,INS_YR_MO
		,CS_INS_CO
		,PRD_TP
		,CS_PWD
		,LST_CS_PWD
		,CS_KN_TP
		,OCPP_VER
		,V2X_TP
		,CS_SVC_TP
		,LH_CP_CS_ID
		,CPO_CP_CS_ID
		,REG_DT
		,REG_ID
		,UPD_DT
		,UPD_ID
	)VALUES(
		 #{chargingStation.cpId}
		,#{chargingStation.csId}
		,#{chargingStation.csUniqId}
		,#{chargingStation.csChanelCount}
		,#{chargingStation.electSupplyCapability}
		,#{chargingStation.csCatCode}
		,#{chargingStation.useYn}
		,#{chargingStation.brkdownYn}
		,#{chargingStation.makerType}
		,#{chargingStation.insYearMon}
		,#{chargingStation.csInstallCo}
		,#{chargingStation.prodType}
		,#{chargingStation.csPassword}
		,#{chargingStation.lastCsPassword}
		,#{chargingStation.csKindType}
		,#{chargingStation.ocppVersion}
		,#{chargingStation.v2xType}
		,#{chargingStation.csServiceType}
		,#{chargingStation.lhCpCsId}
		,#{chargingStation.cpoCpCsId}
		,#{chargingStation.writer.registrationDate}
		,#{chargingStation.writer.regUserId}
		,#{chargingStation.writer.updateDate}
		,#{chargingStation.writer.updUserId}
	)
	</insert>
	
	<insert id="insertChargingStationCsm" parameterType="ChargingStationCsm">
	INSERT INTO TB_CHCS002(
		 CP_ID
		,CS_ID
		,FW_VER
		,MODEL_NM
		,SER_NO
		,LAST_BOOT_DT
	)VALUES(
		 #{chargingStationCsm.cpId}
		,#{chargingStationCsm.csId}
		,#{chargingStationCsm.fwVer}
		,#{chargingStationCsm.modelName}
		,#{chargingStationCsm.serialNumber}
		,#{chargingStationCsm.lastBootDate}
	)
	</insert>
	
	<update id="updateChargingStation" parameterType="ChargingStation">
	UPDATE TB_CHCS001
	   SET CS_CAT_CD 	= #{chargingStation.csCatCode}
	      ,CS_UNIQ_ID 	= #{chargingStation.csUniqId}
	      ,CS_CHN_CNT	= #{chargingStation.csChanelCount}
	      ,ELEC_SPLY_CPTY = #{chargingStation.electSupplyCapability}
	      ,US_YN 		= #{chargingStation.useYn}
	      ,BD_YN 		= #{chargingStation.brkdownYn}
	      ,MAKER_TP 	= #{chargingStation.makerType}
	      ,INS_YR_MO 	= #{chargingStation.insYearMon}
	      ,CS_INS_CO 	= #{chargingStation.csInstallCo}
	      ,PRD_TP		= #{chargingStation.prodType}
	      ,CS_PWD       = #{chargingStation.csPassword}
	      ,LST_CS_PWD  = #{chargingStation.lastCsPassword}
	      ,CS_KN_TP		= #{chargingStation.csKindType}
	      ,OCPP_VER		= #{chargingStation.ocppVersion}
	      ,V2X_TP		= #{chargingStation.v2xType}
	      ,CS_SVC_TP	= #{chargingStation.csServiceType}
	      ,LH_CP_CS_ID	= #{chargingStation.lhCpCsId}
	      ,CPO_CP_CS_ID	= #{chargingStation.cpoCpCsId}
		  ,UPD_DT       = #{chargingStation.writer.updateDate}
		  ,UPD_ID       = #{chargingStation.writer.updUserId}
	 WHERE CP_ID = #{chargingStation.cpId}
	   AND CS_ID = #{chargingStation.csId}
	</update>
	
	<update id="updateChargingStationCsm" parameterType="ChargingStationCsm">
	UPDATE TB_CHCS002
	   SET FW_VER		= #{chargingStationCsm.fwVer}
	      ,MODEL_NM		= #{chargingStationCsm.modelName}
	      ,SER_NO		= #{chargingStationCsm.serialNumber}
	      ,LAST_BOOT_DT = #{chargingStationCsm.lastBootDate}
	 WHERE CP_ID = #{chargingStationCsm.cpId}
	   AND CS_ID = #{chargingStationCsm.csId}
	</update>
	
	<select id="selectChargingStationByCpIdNCsId" parameterType="Map" resultMap="ChargingStation-resultMap">
	SELECT A.CP_ID
		  ,A.CS_ID
		  ,A.CS_UNIQ_ID
		  ,A.CS_CHN_CNT
		  ,A.ELEC_SPLY_CPTY
		  ,A.CS_CAT_CD
		  ,A.US_YN
		  ,A.BD_YN
		  ,A.MAKER_TP
		  ,A.INS_YR_MO
		  ,A.CS_INS_CO
		  ,A.PRD_TP
		  ,A.CS_PWD
		  ,A.LST_CS_PWD
		  ,A.CS_KN_TP
		  ,A.OCPP_VER
		  ,A.V2X_TP
		  ,A.CS_SVC_TP
		  ,A.LH_CP_CS_ID
		  ,A.CPO_CP_CS_ID
		  ,A.REG_DT
		  ,A.REG_ID
		  ,A.UPD_DT
		  ,A.UPD_ID
	  FROM TB_CHCS001 A
	 WHERE A.CP_ID = #{cpId}
	   AND A.CS_ID = #{csId}
	</select>

	<select id="selectChargingStationCsmByCpIdNCsId" parameterType="Map" resultMap="ChargingStationCsm-resultMap">
	SELECT A.CP_ID
		  ,A.CS_ID
		  ,A.CS_UNIQ_ID
		  ,A.CS_CHN_CNT
		  ,A.ELEC_SPLY_CPTY
		  ,A.CS_CAT_CD
		  ,A.US_YN
		  ,A.BD_YN
		  ,A.MAKER_TP
		  ,A.INS_YR_MO
		  ,A.CS_INS_CO
		  ,A.PRD_TP
		  ,A.CS_PWD
		  ,A.LST_CS_PWD
		  ,A.CS_KN_TP
		  ,A.OCPP_VER
		  ,A.V2X_TP
		  ,A.CS_SVC_TP
		  ,A.LH_CP_CS_ID
		  ,A.CPO_CP_CS_ID
		  ,A.REG_DT
		  ,A.REG_ID
		  ,A.UPD_DT
		  ,A.UPD_ID
		  ,B.FW_VER
		  ,B.MODEL_NM
		  ,B.SER_NO
		  ,B.LAST_BOOT_DT
	  FROM TB_CHCS001 A, TB_CHCS002 B
	 WHERE A.CP_ID = B.CP_ID
	   AND A.CS_ID = B.CS_ID
	   AND A.CP_ID = #{cpId}
	   AND A.CS_ID = #{csId}
	</select>

	<select id="selectChargingStationDtoByCpIdNCsId" parameterType="Map" resultMap="ChargingStationDto-resultMap">
	SELECT A.CP_ID
		  ,A.CS_ID
		  ,A.CS_UNIQ_ID
		  ,A.CS_CHN_CNT
		  ,A.ELEC_SPLY_CPTY
		  ,A.CS_CAT_CD
		  ,A.US_YN
		  ,A.BD_YN
		  ,A.MAKER_TP
		  ,A.INS_YR_MO
		  ,A.CS_INS_CO
		  ,A.PRD_TP
		  ,A.CS_PWD
		  ,A.LST_CS_PWD
		  ,A.CS_KN_TP
		  ,A.OCPP_VER
		  ,A.V2X_TP
		  ,A.CS_SVC_TP
		  ,A.LH_CP_CS_ID
		  ,A.CPO_CP_CS_ID
		  ,A.REG_DT
		  ,A.REG_ID
		  ,A.UPD_DT
		  ,A.UPD_ID
		  ,B.FW_VER
		  ,B.MODEL_NM
		  ,B.SER_NO
		  ,B.LAST_BOOT_DT
		  ,C.CP_NM
		  ,CX.CX_NM
	  FROM TB_CHCS001 A
		   LEFT JOIN TB_CHCS002 B
		ON A.CP_ID = B.CP_ID
	   AND A.CS_ID = B.CS_ID
		   INNER JOIN TB_CHCP001 C
		ON A.CP_ID = C.CP_ID
		   LEFT JOIN TB_ORCX001 CX
		ON C.CX_ID = CX.CX_ID
	 WHERE A.CP_ID = #{cpId}
	   AND A.CS_ID = #{csId}
	</select>

