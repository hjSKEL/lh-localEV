		<result column="SWAP_TMO_SEC" property="swapTimeoutSec" />
		<result column="MIN_SOH" property="minSoHThreshold" />
		<result column="MIN_SOC" property="minSoCThreshold" />
	</resultMap>

	<!-- TB_BSCS001 조회 컬럼 (D 별칭 기준) — 모든 select 에 포함되어야 notNullColumn 판정이 동작 -->
