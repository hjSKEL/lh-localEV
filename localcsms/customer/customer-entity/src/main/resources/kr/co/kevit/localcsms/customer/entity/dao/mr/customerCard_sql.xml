<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="kr.co.kevit.localcsms.customer.entity.dao.CustomerCardMapper">
		
	<resultMap type="CustomerCard" id="CustomerCard-resultMap">
		<id column="CUT_CRD_NO"			property="cutCardNo"/>
		<result column="CUT_ID"			property="customerId"/>
		<result column="STOP_YN"		property="stopYn"/>
		<result column="STOP_DT"		property="stopDate"/>
		<result column="STOP_RSN_CD"	property="stopRsnCd"/>
		<result column="STOP_RSN_TXT"	property="stopRsnTxt"/>
		<result	column="REG_DT" 		property="writer.registrationDate" />
		<result	column="REG_ID" 		property="writer.regUserId" />
		<result	column="UPD_DT" 		property="writer.updateDate" />
		<result	column="UPD_ID" 		property="writer.updUserId" />
	</resultMap>
	<resultMap type="CustomerCardDto" id="CustomerCardDto-resultMap">
		<id column="CUT_CRD_NO"			property="cutCardNo"/>
		<result column="CUT_ID"			property="customerId"/>
		<result column="STOP_YN"		property="stopYn"/>
		<result column="STOP_DT"		property="stopDate"/>
		<result column="STOP_RSN_CD"	property="stopRsnCd"/>
		<result column="STOP_RSN_TXT"	property="stopRsnTxt"/>
		<result	column="REG_DT" 		property="writer.registrationDate" />
		<result	column="REG_ID" 		property="writer.regUserId" />
		<result	column="UPD_DT" 		property="writer.updateDate" />
		<result	column="UPD_ID" 		property="writer.updUserId" />
		
		<result column="CUT_NM"			property="customerName"/>
		<result column="DONG"			property="dong"/>
		<result column="HO"				property="ho"/>
		<result column="CX_NM"			property="complexName"/>
	</resultMap>
	
	
	<insert id="insertMemberCard" parameterType="CustomerCard">
	INSERT INTO TB_CUCA001(
		 CUT_CRD_NO
		,CUT_ID
		,STOP_YN
		,STOP_DT
		,STOP_RSN_CD
		,STOP_RSN_TXT
		,REG_DT
		,REG_ID
		,UPD_DT
		,UPD_ID
	)VALUES(
		 #{memberCard.cutCardNo}
		,#{memberCard.customerId}
		,#{memberCard.stopYn}
		,#{memberCard.stopDate}
		,#{memberCard.stopRsnCd}
		,#{memberCard.stopRsnTxt}
		,#{memberCard.writer.registrationDate}
		,#{memberCard.writer.regUserId}
		,#{memberCard.writer.updateDate}
		,#{memberCard.writer.updUserId}
	)
	</insert>

	<update id="updateMemberCard" parameterType="CustomerCard">
	UPDATE TB_CUCA001
	   SET CUT_CRD_NO = #{memberCard.cutCardNo}
	   	  ,CUT_ID = #{memberCard.customerId}
	   	  ,STOP_YN = #{memberCard.stopYn}
	   	  ,STOP_DT = #{memberCard.stopDate}
	   	  ,STOP_RSN_CD = #{memberCard.stopRsnCd}
	   	  ,STOP_RSN_TXT = #{memberCard.stopRsnTxt}
	   	  ,UPD_DT = #{memberCard.writer.updateDate}
	   	  ,UPD_ID = #{memberCard.writer.updUserId}
	 WHERE CUT_CRD_NO = #{memberCard.cutCardNo}
	</update>

	<select id="selectMemberCard" parameterType="String" resultMap="CustomerCardDto-resultMap">
	SELECT CUT_CRD_NO
		  ,CUT_ID
		  ,STOP_YN
		  ,STOP_DT
		  ,STOP_RSN_CD
		  ,STOP_RSN_TXT
		  ,REG_DT
	  FROM TB_CUCA001
	 WHERE CUT_CRD_NO = #{cutCardNo}
	</select>

	<select id="countMemberCardByMemberCardSearchCond" parameterType="CustomerCardSearchCond" resultType="Integer">
	SELECT COUNT(A.CUT_CRD_NO)
	  FROM TB_CUCA001 A
	  	   LEFT OUTER JOIN TB_CUCU001 B
	  	ON A.CUT_ID = B.CUT_ID
	<include refid="WhereForMemberCardByMemberCardSearchCond" />
	</select>
	
	<sql id="WhereForMemberCardByMemberCardSearchCond">
		<where>
			<if test="searchCond.cutCardNo != null and searchCond.cutCardNo != ''">
			AND A.CUT_CRD_NO = #{searchCond.cutCardNo}
			</if>
			<if test="searchCond.stopYn != null and searchCond.stopYn != ''">
			AND A.STOP_YN = #{searchCond.stopYn}
			</if>
			<if test="searchCond.customerId != null and searchCond.customerId != ''">
			AND A.CUT_ID = #{searchCond.customerId}
			</if>
			<if test="searchCond.customerName != null and searchCond.customerName != ''">
			AND B.CUT_NM LIKE CONCAT('%',#{searchCond.customerName},'%')
			</if>
		</where>
	</sql>
	
	<select id="selectMemberCardByMemberCardSearchCond" parameterType="CustomerCardSearchCond" resultMap="CustomerCardDto-resultMap">
	SELECT A.CUT_CRD_NO
		  ,A.CUT_ID
		  ,A.STOP_YN
		  ,A.STOP_DT
		  ,A.STOP_RSN_CD
		  ,A.STOP_RSN_TXT
		  ,A.REG_DT
		  ,B.CUT_NM
		  ,B.DONG
		  ,B.HO
		  ,CX.CX_NM
	  FROM TB_CUCA001 A
	  	   LEFT OUTER JOIN TB_CUCU001 B
	  	ON A.CUT_ID = B.CUT_ID
	  	   LEFT JOIN TB_ORCX001 CX
	  	ON B.CX_ID = CX.CX_ID
	<include refid="WhereForMemberCardByMemberCardSearchCond" />
	<choose>
		<when test="searchCond.sortOrder == 'A'.toString()">ORDER BY A.CUT_CRD_NO ASC</when>
		<when test="searchCond.sortOrder == 'B'.toString()">ORDER BY A.CUT_CRD_NO DESC</when>
		<when test="searchCond.sortOrder == 'C'.toString()">ORDER BY B.CUT_NM ASC</when>
		<when test="searchCond.sortOrder == 'D'.toString()">ORDER BY B.CUT_NM DESC</when>
		<otherwise>ORDER BY A.CUT_ID</otherwise>
	</choose>
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>
</mapper>