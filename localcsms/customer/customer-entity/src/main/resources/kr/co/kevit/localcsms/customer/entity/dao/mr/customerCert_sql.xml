<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="kr.co.kevit.localcsms.customer.entity.dao.CustomerCertMapper">

	<resultMap type="CustomerCert" id="CustomerCert-resultMap">
		<id     column="CUT_ID"			property="customerId" />
		<result column="EMAID"			property="eMaid" />
		<result column="PCID"			property="pcid" />
		<result column="SN"				property="serialNumber" />
		<result column="SUB_DN"			property="subjectDn" />
		<result column="XSD_MSG_DEF_NMSP"	property="xsdMsgDefNamespace" />
		<result column="CERT_VAL_FROM"	property="certValidFrom" />
		<result column="CERT_VAL_TO"	property="certValidTo" />
		<result column="STAT"			property="status" />
		<result column="OCSP_RESP_URL"	property="ocspResponderURL" />
		<result column="REG_DT" 		property="writer.registrationDate" />
		<result column="REG_ID" 		property="writer.regUserId" />
		<result column="UPD_DT" 		property="writer.updateDate" />
		<result column="UPD_ID" 		property="writer.updUserId" />
	</resultMap>
	
	
	<insert id="insertCustomerCert" parameterType="CustomerCert">
	INSERT INTO TB_CACU001(
		 EMAID
		,PCID
		,CUT_ID
		,SN
		,SUB_DN
		,XSD_MSG_DEF_NMSP
		,CERT_VAL_FROM
		,CERT_VAL_TO
		,STAT
		,OCSP_RESP_URL
		,REG_DT
		,REG_ID
		,UPD_DT
		,UPD_ID
	)VALUES(
		 #{cert.eMaid}
		,#{cert.pcid}
		,#{cert.customerId}
		,#{cert.serialNumber}
		,#{cert.subjectDn}
		,#{cert.xsdMsgDefNamespace}
		,#{cert.certValidFrom}
		,#{cert.certValidTo}
		,#{cert.status}
		,#{cert.ocspResponderURL}
		,#{cert.writer.registrationDate}
		,#{cert.writer.regUserId}
		,#{cert.writer.updateDate}
		,#{cert.writer.updUserId}
	)
	</insert>
	
	<update id="updateCustomerCert" parameterType="CustomerCert">
	UPDATE TB_CACU001
	   SET SN     	= #{cert.serialNumber}
	      ,SUB_DN	= #{cert.subjectDn}
	      ,XSD_MSG_DEF_NMSP   = #{cert.xsdMsgDefNamespace}
	      ,CERT_VAL_FROM   = #{cert.certValidFrom}
	      ,CERT_VAL_TO   = #{cert.certValidTo}
	      ,STAT     = #{cert.status}
	      ,OCSP_RESP_URL	= #{cert.ocspResponderURL}
	      ,UPD_DT   = #{cert.writer.updateDate}
	      ,UPD_ID   = #{cert.writer.updUserId}
	 WHERE EMAID   	= #{cert.eMaid}
	</update>
	
	<delete id="deleteCustomerCert" parameterType="String">
	DELETE FROM TB_CACU001
		  WHERE EMAID = #{emaid}
	</delete>
	
	<select id="selectCustomerCert" parameterType="String" resultMap="CustomerCert-resultMap">
	SELECT EMAID
		  ,PCID
		  ,CUT_ID
		  ,SN
		  ,SUB_DN
		  ,XSD_MSG_DEF_NMSP
		  ,CERT_VAL_FROM
		  ,CERT_VAL_TO
		  ,STAT
		  ,OCSP_RESP_URL
		  ,REG_DT
		  ,REG_ID
		  ,UPD_DT
		  ,UPD_ID
	  FROM TB_CACU001
	 WHERE CUT_ID = #{customerId}
	</select>

	<select id="selectCustomerCertByPcid" parameterType="String" resultMap="CustomerCert-resultMap">
	SELECT EMAID
		  ,PCID
		  ,CUT_ID
		  ,SN
		  ,SUB_DN
		  ,XSD_MSG_DEF_NMSP
		  ,CERT_VAL_FROM
		  ,CERT_VAL_TO
		  ,STAT
		  ,OCSP_RESP_URL
		  ,REG_DT
		  ,REG_ID
		  ,UPD_DT
		  ,UPD_ID
	  FROM TB_CACU001
	 WHERE PCID = #{pcid}
	</select>

	<select id="selectCustomerCertByEmaid" parameterType="String" resultMap="CustomerCert-resultMap">
	SELECT EMAID
		  ,PCID
		  ,CUT_ID
		  ,SN
		  ,SUB_DN
		  ,XSD_MSG_DEF_NMSP
		  ,CERT_VAL_FROM
		  ,CERT_VAL_TO
		  ,STAT
		  ,OCSP_RESP_URL
		  ,REG_DT
		  ,REG_ID
		  ,UPD_DT
		  ,UPD_ID
	  FROM TB_CACU001
	 WHERE EMAID = #{emaid}
	</select>
	
	<select id="countCustomerCertBySearchCond" parameterType="CustomerCertSearchCond" resultType="Integer">
	SELECT COUNT(1)
	  FROM TB_CACU001
	  <include refid="WhereCustomerCertBySearchCond"/>
	</select>
	
	<sql id="WhereCustomerCertBySearchCond">
	<where>
		<if test="searchCond.customerId != null and searchCond.customerId != ''">
		AND CUT_ID = #{searchCond.customerId}
		</if>
		<if test="searchCond.eMaid != null and searchCond.eMaid != ''">
		AND EMAID LIKE CONCAT('%', #{searchCond.eMaid}, '%')
		</if>
		<if test="searchCond.status != null and searchCond.status != ''">
		AND STAT = #{searchCond.status}
		</if>
	</where>
	</sql>
		
	<select id="selectCustomerCertBySearchCond" parameterType="CustomerCertSearchCond" resultMap="CustomerCert-resultMap">
	SELECT EMAID
		  ,PCID
		  ,CUT_ID
		  ,SN
		  ,SUB_DN
		  ,XSD_MSG_DEF_NMSP
		  ,CERT_VAL_FROM
		  ,CERT_VAL_TO
		  ,STAT
		  ,OCSP_RESP_URL
		  ,REG_DT
		  ,REG_ID
		  ,UPD_DT
		  ,UPD_ID
	  FROM TB_CACU001
	  <include refid="WhereCustomerCertBySearchCond"/>
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>

</mapper>
