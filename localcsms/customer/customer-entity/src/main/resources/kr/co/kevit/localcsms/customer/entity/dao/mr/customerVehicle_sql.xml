<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.kevit.localcsms.customer.entity.dao.CustomerVehicleMapper">

    <resultMap type="CustomerVehicle" id="CustomerVehicle-resultMap">
        <id     column="EVCC_ID"      property="evccId"/>
        <result column="CUT_ID"       property="customerId"/>
        <result column="VIN_NO"       property="vinNo"/>
        <result column="CAR_MODEL_ID" property="carModelId"/>
        <result column="CAR_NM"       property="carName"/>
        <result column="CAR_NO"       property="carNo"/>
        <result column="V2X_YN"       property="v2xYn"/>
        <result column="REG_DT"       property="writer.registrationDate"/>
        <result column="REG_ID"       property="writer.regUserId"/>
        <result column="UPD_DT"       property="writer.updateDate"/>
        <result column="UPD_ID"       property="writer.updUserId"/>
    </resultMap>

    <insert id="insertVehicle" parameterType="CustomerVehicle">
        INSERT INTO TB_CUEV001(
             EVCC_ID
            ,CUT_ID
            ,VIN_NO
            ,CAR_MODEL_ID
            ,CAR_NM
            ,CAR_NO
            ,V2X_YN
            ,REG_DT
            ,REG_ID
            ,UPD_DT
            ,UPD_ID
        ) VALUES (
             #{vehicle.evccId}
            ,#{vehicle.customerId}
            ,#{vehicle.vinNo}
            ,#{vehicle.carModelId}
            ,#{vehicle.carName}
            ,#{vehicle.carNo}
            ,#{vehicle.v2xYn}
            ,#{vehicle.writer.registrationDate}
            ,#{vehicle.writer.regUserId}
            ,#{vehicle.writer.updateDate}
            ,#{vehicle.writer.updUserId}
        )
    </insert>

    <update id="updateVehicle" parameterType="CustomerVehicle">
        UPDATE TB_CUEV001
           SET CUT_ID       = #{vehicle.customerId}
              ,VIN_NO       = #{vehicle.vinNo}
              ,CAR_MODEL_ID = #{vehicle.carModelId}
              ,CAR_NM       = #{vehicle.carName}
              ,CAR_NO       = #{vehicle.carNo}
              ,V2X_YN       = #{vehicle.v2xYn}
              ,UPD_DT       = #{vehicle.writer.updateDate}
              ,UPD_ID       = #{vehicle.writer.updUserId}
         WHERE EVCC_ID = #{vehicle.evccId}
    </update>

    <delete id="deleteVehicle" parameterType="String">
        DELETE FROM TB_CUEV001
         WHERE EVCC_ID = #{evccId}
    </delete>

    <select id="selectByEvccId" parameterType="String" resultMap="CustomerVehicle-resultMap">
        SELECT EVCC_ID, CUT_ID, VIN_NO, CAR_MODEL_ID, CAR_NM, CAR_NO, V2X_YN,
               REG_DT, REG_ID, UPD_DT, UPD_ID
          FROM TB_CUEV001
         WHERE EVCC_ID = #{evccId}
    </select>

    <select id="selectByCustomerId" parameterType="String" resultMap="CustomerVehicle-resultMap">
        SELECT EVCC_ID, CUT_ID, VIN_NO, CAR_MODEL_ID, CAR_NM, CAR_NO, V2X_YN,
               REG_DT, REG_ID, UPD_DT, UPD_ID
          FROM TB_CUEV001
         WHERE CUT_ID = #{customerId}
         ORDER BY REG_DT DESC
    </select>

    <sql id="WhereForVehicleSearch">
        <where>
            <if test="searchCond.evccId != null and searchCond.evccId != ''">
                AND EVCC_ID LIKE CONCAT('%', #{searchCond.evccId}, '%')
            </if>
            <if test="searchCond.customerId != null and searchCond.customerId != ''">
                AND CUT_ID = #{searchCond.customerId}
            </if>
            <if test="searchCond.carNo != null and searchCond.carNo != ''">
                AND CAR_NO LIKE CONCAT('%', #{searchCond.carNo}, '%')
            </if>
            <if test="searchCond.v2xYn != null and searchCond.v2xYn != ''">
                AND V2X_YN = #{searchCond.v2xYn}
            </if>
        </where>
    </sql>

    <select id="countBySearchCond" parameterType="CustomerVehicleSearchCond" resultType="Integer">
        SELECT COUNT(EVCC_ID)
          FROM TB_CUEV001
        <include refid="WhereForVehicleSearch"/>
    </select>

    <select id="selectBySearchCond" parameterType="CustomerVehicleSearchCond" resultMap="CustomerVehicle-resultMap">
        SELECT EVCC_ID, CUT_ID, VIN_NO, CAR_MODEL_ID, CAR_NM, CAR_NO, V2X_YN,
               REG_DT, REG_ID, UPD_DT, UPD_ID
          FROM TB_CUEV001
        <include refid="WhereForVehicleSearch"/>
         ORDER BY REG_DT DESC
         LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
    </select>

</mapper>
