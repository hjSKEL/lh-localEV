<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DIR"     value="OCPP16_LOG"/>
    <property name="LOG_APP"     value="ocpp16-daemon"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- ① 콘솔 출력 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ② 파일 출력 : 날짜 변경 OR 100MB 초과 시 새 파일 생성 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${LOG_APP}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 날짜 변경 시 날짜 파트가 바뀌고, 100MB 초과 시 인덱스(%i) 증가 -->
            <fileNamePattern>${LOG_DIR}/${LOG_APP}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <!-- 보관 기간 : 30일 -->
            <maxHistory>30</maxHistory>
            <!-- 전체 누적 상한 : 3GB -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 데몬 패키지는 DEBUG 레벨로 상세 출력 -->
    <logger name="kr.co.kevit.localcsms.ocpp" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
