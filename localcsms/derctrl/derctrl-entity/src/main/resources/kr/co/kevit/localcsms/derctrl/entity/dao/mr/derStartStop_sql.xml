<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="kr.co.kevit.localcsms.derctrl.entity.dao.DerStartStopMapper">

	<resultMap type="DerStartStop" id="DerStartStop-resultMap">
		<id     column="SEQ"          property="seq"/>
		<result column="CP_ID"        property="cpId"/>
		<result column="CS_ID"        property="csId"/>
		<result column="CONTROL_ID"   property="controlId"/>
		<result column="STARTED_YN"   property="startedYn"/>
		<result column="TIMESTAMP_DT" property="timestampDt"  jdbcType="TIMESTAMP" javaType="java.util.Date" typeHandler="org.apache.ibatis.type.DateTypeHandler"/>
		<result column="RECEIVED_DT"  property="receivedDate" jdbcType="TIMESTAMP" javaType="java.util.Date" typeHandler="org.apache.ibatis.type.DateTypeHandler"/>
	</resultMap>

	<resultMap type="DerStartStopDto" id="DerStartStopDto-resultMap" extends="DerStartStop-resultMap"/>

	<insert id="insertStartStop" parameterType="DerStartStop" useGeneratedKeys="true" keyProperty="event.seq">
	INSERT INTO TB_DRCTL04(
		 CP_ID, CS_ID, CONTROL_ID, STARTED_YN, TIMESTAMP_DT, RECEIVED_DT
	)VALUES(
		 #{event.cpId}, #{event.csId}, #{event.controlId}, #{event.startedYn},
		 #{event.timestampDt}, #{event.receivedDate}
	)
	</insert>

	<sql id="WhereForStartStopSearchCond">
		<where>
			<if test="searchCond.cpId != null and searchCond.cpId != ''">
			AND CP_ID = #{searchCond.cpId}
			</if>
			<if test="searchCond.csId != null and searchCond.csId != ''">
			AND CS_ID = #{searchCond.csId}
			</if>
			<if test="searchCond.controlId != null and searchCond.controlId != ''">
			AND CONTROL_ID = #{searchCond.controlId}
			</if>
			<if test="searchCond.startedYn != null and searchCond.startedYn != ''">
			AND STARTED_YN = #{searchCond.startedYn}
			</if>
			<if test="searchCond.fromDate != null">
			AND TIMESTAMP_DT &gt;= #{searchCond.fromDate}
			</if>
			<if test="searchCond.toDate != null">
			AND TIMESTAMP_DT &lt;= #{searchCond.toDate}
			</if>
		</where>
	</sql>

	<select id="countStartStopBySearchCond" parameterType="DerStartStopSearchCond" resultType="Integer">
	SELECT COUNT(SEQ) FROM TB_DRCTL04
	<include refid="WhereForStartStopSearchCond"/>
	</select>

	<select id="selectStartStopBySearchCond" parameterType="DerStartStopSearchCond" resultMap="DerStartStopDto-resultMap">
	SELECT SEQ, CP_ID, CS_ID, CONTROL_ID, STARTED_YN, TIMESTAMP_DT, RECEIVED_DT
	  FROM TB_DRCTL04
	<include refid="WhereForStartStopSearchCond"/>
	 ORDER BY TIMESTAMP_DT DESC, SEQ DESC
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>

</mapper>
