<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="kr.co.kevit.localcsms.payment.entity.dao.PrepaidCardHisMapper">

	<resultMap type="PrepaidCardHis" id="PrepaidCardHis-resultMap">
		<id     column="SEQ"            property="seq"/>
		<result column="CARD_NO"        property="cardNo"/>
		<result column="TYPE_CD"        property="typeCode"/>
		<result column="AMOUNT"         property="amount"/>
		<result column="BAL_BEFORE"     property="balanceBefore"/>
		<result column="BAL_AFTER"      property="balanceAfter"/>
		<result column="RC_ID"          property="rechargingId"/>
		<result column="REG_DT"         property="writer.registrationDate"/>
		<result column="REG_ID"         property="writer.regUserId"/>
		<result column="UPD_DT"         property="writer.updateDate"/>
		<result column="UPD_ID"         property="writer.updUserId"/>
	</resultMap>

	<resultMap type="PrepaidCardHisDto" id="PrepaidCardHisDto-resultMap" extends="PrepaidCardHis-resultMap">
		<result column="CUT_NM"         property="customerName"/>
	</resultMap>

	<insert id="insertPrepaidCardHis" parameterType="PrepaidCardHis"
	        useGeneratedKeys="true" keyProperty="history.seq" keyColumn="SEQ">
	INSERT INTO TB_PYCH001(
		 CARD_NO
		,TYPE_CD
		,AMOUNT
		,BAL_BEFORE
		,BAL_AFTER
		,RC_ID
		,REG_DT
		,REG_ID
		,UPD_DT
		,UPD_ID
	)VALUES(
		 #{history.cardNo}
		,#{history.typeCode}
		,#{history.amount}
		,#{history.balanceBefore}
		,#{history.balanceAfter}
		,#{history.rechargingId}
		,#{history.writer.registrationDate}
		,#{history.writer.regUserId}
		,#{history.writer.updateDate}
		,#{history.writer.updUserId}
	)
	</insert>

	<select id="selectPrepaidCardHis" parameterType="Long" resultMap="PrepaidCardHis-resultMap">
	SELECT SEQ
	      ,CARD_NO
	      ,TYPE_CD
	      ,AMOUNT
	      ,BAL_BEFORE
	      ,BAL_AFTER
	      ,RC_ID
	      ,REG_DT
	      ,REG_ID
	      ,UPD_DT
	      ,UPD_ID
	  FROM TB_PYCH001
	 WHERE SEQ = #{seq}
	</select>

	<sql id="WhereForPrepaidCardHisBySearchCond">
		<where>
			<if test="searchCond.cardNo != null and searchCond.cardNo != ''">
			AND A.CARD_NO = #{searchCond.cardNo}
			</if>
			<if test="searchCond.customerId != null and searchCond.customerId != ''">
			AND C.CUT_ID = #{searchCond.customerId}
			</if>
			<if test="searchCond.typeCode != null and searchCond.typeCode != ''">
			AND A.TYPE_CD = #{searchCond.typeCode}
			</if>
			<if test="searchCond.rechargingId != null and searchCond.rechargingId != ''">
			AND A.RC_ID = #{searchCond.rechargingId}
			</if>
			<if test="searchCond.fromDate != null">
			AND A.REG_DT &gt;= #{searchCond.fromDate}
			</if>
			<if test="searchCond.toDate != null">
			AND A.REG_DT &lt;= #{searchCond.toDate}
			</if>
		</where>
	</sql>

	<select id="countPrepaidCardHisBySearchCond" parameterType="PrepaidCardHisSearchCond" resultType="Integer">
	SELECT COUNT(A.SEQ)
	  FROM TB_PYCH001 A
	  INNER JOIN TB_PYCD001 C
	    ON A.CARD_NO = C.CARD_NO
	  LEFT OUTER JOIN TB_CUCU001 B
	    ON C.CUT_ID = B.CUT_ID
	<include refid="WhereForPrepaidCardHisBySearchCond" />
	</select>

	<select id="selectPrepaidCardHisBySearchCond" parameterType="PrepaidCardHisSearchCond" resultMap="PrepaidCardHisDto-resultMap">
	SELECT A.SEQ
	      ,A.CARD_NO
	      ,A.TYPE_CD
	      ,A.AMOUNT
	      ,A.BAL_BEFORE
	      ,A.BAL_AFTER
	      ,A.RC_ID
	      ,A.REG_DT
	      ,A.REG_ID
	      ,A.UPD_DT
	      ,A.UPD_ID
	      ,B.CUT_NM
	  FROM TB_PYCH001 A
	  INNER JOIN TB_PYCD001 C
	    ON A.CARD_NO = C.CARD_NO
	  LEFT OUTER JOIN TB_CUCU001 B
	    ON C.CUT_ID = B.CUT_ID
	<include refid="WhereForPrepaidCardHisBySearchCond" />
	 ORDER BY A.SEQ DESC
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>

</mapper>
