<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="kr.co.kevit.localcsms.product.entity.dao.ProductMapper">

	<resultMap type="Product" id="Product-resultMap">
		<id     column="ID"			property="id"/>
		<result column="NAME"		property="name"/>
		<result column="REG_DT"		property="writer.registrationDate"/>
		<result column="REG_ID"		property="writer.regUserId"/>
		<result column="UPD_DT"		property="writer.updateDate"/>
		<result column="UPD_ID"		property="writer.updUserId"/>
	</resultMap>
	
	<insert id="insertProduct" parameterType="Product">
	INSERT INTO TB_PDPD001(
		 ID
		,NAME
		,REG_DT
		,REG_ID
		,UPD_DT
		,UPD_ID
	)VALUES(
		 #{product.id}
		,#{product.name}
		,#{product.writer.registrationDate}
		,#{product.writer.regUserId}
		,#{product.writer.updateDate}
		,#{product.writer.updUserId}
	)
	</insert>
	
	<update id="updateProduct" parameterType="Product">
	UPDATE TB_PDPD001
	   SET NAME = #{product.name}
	      ,UPD_DT = #{product.writer.updateDate}
	      ,UPD_ID = #{product.writer.updUserId}
	 WHERE ID = #{product.id}
	</update>
	
	<select id="selectProduct" parameterType="String" resultMap="Product-resultMap">
	SELECT  ID
		   ,NAME
		   ,REG_DT
		   ,REG_ID
		   ,UPD_DT
		   ,UPD_ID
	  FROM TB_PDPD001
	 WHERE ID = #{id}
	</select>
	
	<select id="countProductByProductSearchCond" parameterType="ProductSearchCond" resultType="Integer">
	SELECT COUNT(ID)
	  FROM TB_PDPD001
	<include refid="WhereForProductByProductSearchCond" />
	</select>
	
	<sql id="WhereForProductByProductSearchCond">
		<if test="searchCond.name != null and searchCond.name != ''">
	 WHERE NAME LIKE CONCAT('%', #{searchCond.name}, '%')
		</if>
	</sql>
	
	<select id="selectProductByProductSearchCond" parameterType="ProductSearchCond" resultMap="Product-resultMap">
	SELECT  ID
		   ,NAME
		   ,REG_DT
		   ,REG_ID
		   ,UPD_DT
		   ,UPD_ID
	  FROM TB_PDPD001
	<include refid="WhereForProductByProductSearchCond" />
	 <choose>
		<when test="searchCond.sortOrder == 'A'.toString()">ORDER BY ID ASC</when>
		<when test="searchCond.sortOrder == 'B'.toString()">ORDER BY ID DESC</when>
		<when test="searchCond.sortOrder == 'C'.toString()">ORDER BY NAME ASC</when>
		<when test="searchCond.sortOrder == 'D'.toString()">ORDER BY NAME DESC</when>
		<otherwise>ORDER BY NAME</otherwise>
	 </choose>
	 LIMIT #{searchCond.pageItemSize} OFFSET #{searchCond.start}
	</select>
	
</mapper>
