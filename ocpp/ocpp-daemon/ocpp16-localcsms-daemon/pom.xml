<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>kr.co.kevit.ocpp</groupId>
    <artifactId>ocpp-daemon</artifactId>
    <version>0.0.1</version>
  </parent>
  <artifactId>ocpp16-localcsms-daemon</artifactId>
	<dependencies>
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>5.1.6</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.ocpp</groupId>
			<artifactId>ocpp16-lc-domain</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.ocpp</groupId>
			<artifactId>ocpp16-pure-daemon</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.localcsms</groupId>
			<artifactId>common-util</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.localcsms</groupId>
			<artifactId>charger-process</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.localcsms</groupId>
			<artifactId>recharging-process</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.localcsms</groupId>
			<artifactId>recharging-fee</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.localcsms</groupId>
			<artifactId>authority-process</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.localcsms</groupId>
			<artifactId>customer-process</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.localcsms</groupId>
			<artifactId>common-process</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>kr.co.kevit.localcsms</groupId>
			<artifactId>product-process</artifactId>
			<version>0.0.1</version>
		</dependency>
		
		<!-- https://mvnrepository.com/artifact/org.apache.camel/camel-micrometer-prometheus -->
		<dependency>
		    <groupId>org.apache.camel</groupId>
		    <artifactId>camel-micrometer-prometheus</artifactId>
		    <version>4.4.0</version>
		</dependency>
	</dependencies>
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
		</resources>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.camel</groupId>
				<artifactId>camel-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<configuration>
					<mainClass>kr.co.kevit.ocpp16.daemon.Ocpp16Launcher</mainClass>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<phase>install</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>